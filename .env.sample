# Database configuration
# Unset → SQLite (default). Set to "asyncpg" for PostgreSQL.
COUSCOUS_DATABASE_TYPE=

# Database name (used for both SQLite and PostgreSQL)
# SQLite example: COUSCOUS_DATABASE_NAME=couscous
COUSCOUS_DATABASE_NAME=couscous

# PostgreSQL settings (only used when COUSCOUS_DATABASE_TYPE=asyncpg):
COUSCOUS_DATABASE_HOST=localhost
COUSCOUS_DATABASE_PORT=5432
COUSCOUS_DATABASE_USER=
COUSCOUS_DATABASE_PASS=
