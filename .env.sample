# PostgreSQL connection — required. Run `docker compose up -d` to start a local instance.
COUSCOUS_DATABASE_HOST=localhost
COUSCOUS_DATABASE_PORT=5432
COUSCOUS_DATABASE_USER=couscous
COUSCOUS_DATABASE_PASS=couscous
COUSCOUS_DATABASE_NAME=couscous

# OAuth — optional. Uncomment and fill in to enable Google/GitHub login.
# COUSCOUS_GOOGLE_CLIENT_ID=
# COUSCOUS_GOOGLE_CLIENT_SECRET=
# COUSCOUS_GITHUB_CLIENT_ID=
# COUSCOUS_GITHUB_CLIENT_SECRET=
# COUSCOUS_OAUTH_REDIRECT_URI=http://localhost:8550/oauth/callback
